# TedBus Server Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit real credentials to version control.

# Application Environment ('development' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Primary MongoDB Connection URI (Atlas Cluster)
# Example: mongodb+srv://<username>:<password>@<cluster-address>/tedbus?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/tedbus?retryWrites=true&w=majority

# Optional Local MongoDB URI for offline development
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/tedbus

# Allowed CORS Origins (comma-separated for multiple allowed origins)
# Example: http://localhost:4200,https://tedbus.com,https://tedbus.vercel.app
CORS_ORIGINS=http://localhost:4200

# Google OAuth 2.0 Credentials (Optional, for Google Sign-In)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT Authentication Configuration (HS256)
JWT_SECRET=replace-with-a-strong-256-bit-random-secret
JWT_ISSUER=tedbus-api
JWT_AUDIENCE=tedbus-client
JWT_EXPIRES_IN_SECONDS=86400

# SMTP Email Delivery Configuration (Optional — required for live outbound email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@tedbus.com

# Browser Web Push (VAPID) Configuration (Optional — required for background Service Worker WebPush)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@tedbus.com
